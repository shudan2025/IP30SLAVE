# Copy to .env on the server and replace every placeholder.
GITLAB_HOST=<server-ip-or-dns>
GITLAB_ROOT_PASSWORD=replace-with-a-random-secret
GITLAB_DB_PASSWORD=replace-with-a-random-secret
GITLAB_SECRETS_DB_KEY_BASE=replace-with-at-least-64-random-characters
GITLAB_SECRETS_SECRET_KEY_BASE=replace-with-at-least-64-random-characters
GITLAB_SECRETS_OTP_KEY_BASE=replace-with-at-least-64-random-characters
GITLAB_SECRETS_ENCRYPTED_SETTINGS_KEY_BASE=replace-with-at-least-64-random-characters
GITLAB_SECRETS_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=["replace-with-32-random-alphanumeric-characters"]
GITLAB_SECRETS_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=["replace-with-32-random-alphanumeric-characters"]
GITLAB_SECRETS_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace-with-32-random-alphanumeric-characters
LDAP_BIND_DN=uid=admin,ou=people,dc=agigactu,dc=com
LDAP_BIND_PASSWORD=replace-with-the-LLDAP-bind-password
DEX_OIDC_ISSUER=https://<server-ip-or-dns>/dex
GITLAB_OIDC_CLIENT_ID=gitlab
GITLAB_OIDC_CLIENT_SECRET=replace-with-a-random-secret
GITLAB_OIDC_REDIRECT_URI=https://<server-ip-or-dns>/gitlab/users/auth/openid_connect/callback
